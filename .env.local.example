NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# Optional fallback if using Supabase's new key naming instead of NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for /admin/users invite and user/access management.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Public intake forms (/apply/mentor, /apply/mentee).
# Both the per-role enable flag AND a matching ?token=<this> are required,
# unless VAM_OS_ALLOW_TOKENLESS_APPLICATIONS=true opens the form without a token.
VAM_OS_ENABLE_MENTOR_APPLICATION=
VAM_OS_ENABLE_MENTEE_APPLICATION=
VAM_OS_APPLY_TOKEN=
# Legacy name, still accepted as a fallback for VAM_OS_APPLY_TOKEN.
VAM_OS_APPLICATION_PILOT_TOKEN=
# Opens the intake forms without a token. Intended for UAT only — leave unset in production.
VAM_OS_ALLOW_TOKENLESS_APPLICATIONS=

# Salt for the hashed-IP rate limit on public forms (apply_submission_log).
# Any long random string; changing it resets the counters. Server-only.
VAM_OS_RATE_LIMIT_SALT=

# Absolute origin used to build links placed in emails, e.g. https://app.example.edu.vn
# No trailing slash. Falls back to the request origin when unset.
VAM_OS_PUBLIC_BASE_URL=

# Outbound email. Sending requires BOTH VAM_OS_EMAIL_ENABLED=true and a
# production runtime, so preview deployments never mail real mentors/applicants.
VAM_OS_EMAIL_ENABLED=

# Which provider carries the mail: brevo (default) or resend.
# Brevo's free plan allows ~300 emails/day against Resend's 100, and a season
# sends ~2.700 in bursts — the daily ceiling is what decides how many days a
# round of letters takes. Only the key of the chosen provider is required.
VAM_OS_EMAIL_PROVIDER=brevo
BREVO_API_KEY=
RESEND_API_KEY=

# The From address, written the way a mail client shows it. The domain must be
# authenticated at the provider (SPF + DKIM) or the mail lands in spam:
#   "VAM Mentoring <no-reply@example.edu.vn>"
VAM_OS_EMAIL_FROM=
# Monitored inbox that receives replies to automated mail.
VAM_OS_EMAIL_REPLY_TO=

# Assisted matching (DeepSeek, OpenAI-compatible API). Only the anonymised
# criteria are sent — codes instead of names, an allow-list of form answers,
# free text redacted. Runs propose pairs; a match is created only when an
# organiser approves one. Unlike email this is NOT limited to production, so a
# run can be tried on staging first.
VAM_OS_AI_MATCHING_ENABLED=
DEEPSEEK_API_KEY=
# Defaults to deepseek-chat.
DEEPSEEK_MODEL=
# Defaults to https://api.deepseek.com. Must be https.
DEEPSEEK_BASE_URL=
