NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# Optional fallback if using Supabase's new key naming instead of NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for /admin/users invite and user/access management.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
VAM_OS_ADMIN_PASSWORD=

# Pilot intake forms (/apply/mentor, /apply/mentee) require ?token=<this>.
# Only consulted when the form's DB state is "pilot": a "closed" form can never
# be opened by a token, and an "open" form ignores it. There is deliberately no
# development bypass — dev and production evaluate the same decision table.
# See lib/apply-gate.ts. Form state lives in public.application_form_controls.
VAM_OS_APPLICATION_PILOT_TOKEN=

# ── Outbound email ────────────────────────────────────────────────────────────
#
# Sending requires BOTH VAM_OS_EMAIL_ENABLED=true AND a production runtime, so
# preview deployments and local builds can never mail real applicants. Every
# attempt is recorded in public.outbound_emails — including the ones the gate
# suppressed, which is what lets an operator see what a deployment would have
# sent before switching it on. Read them at /operations/emails.
#
# Setup runbook: docs/runbooks/email-brevo-setup.md
VAM_OS_EMAIL_ENABLED=

# Which provider carries the mail: brevo (default) or resend. Brevo's free plan
# allows ~300 emails/day against Resend's 100, and a season sends in bursts —
# the daily ceiling is what decides how many days a round of letters takes.
# Only the key of the chosen provider is required.
VAM_OS_EMAIL_PROVIDER=brevo
BREVO_API_KEY=
RESEND_API_KEY=

# The From address, written the way a mail client shows it. The domain must be
# authenticated at the provider (SPF + DKIM) or the mail lands in spam:
#   "UEH Mentoring <hello@alumni-mentoring.edu.vn>"
VAM_OS_EMAIL_FROM=
# Monitored inbox that receives replies to automated mail. A human reads it;
# nothing in the application ingests replies yet.
VAM_OS_EMAIL_REPLY_TO=

# ── Công cụ AI (/ai) ──────────────────────────────────────────────────────────
#
# Server-only. NEVER prefix these with NEXT_PUBLIC_: that ships the key to every
# browser. Without DEEPSEEK_API_KEY the AI tools say "chưa cấu hình" and the rest
# of VAM OS is unaffected. /ai/status shows which keys are set, never the keys.
DEEPSEEK_API_KEY=
# Optional. Defaults to deepseek-chat.
DEEPSEEK_MODEL=
# Optional. Defaults to https://api.deepseek.com.
DEEPSEEK_BASE_URL=
# Optional. Web search for "Xu hướng ngành"; without it answers are general
# knowledge only and the screen says so.
TAVILY_API_KEY=
